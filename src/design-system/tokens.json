{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "SheRise TN Master Design System",
  "version": "2.0.0",
  "description": "Master design system & tokens for SheRise TN - Tamil Nadu Women's Empowerment Platform",
  "brand": {
    "name": "SheRise TN",
    "tamilName": "ஷி ரைஸ் தமிழ்நாடு",
    "tagline": "Your safety. Your skills. Your sovereignty.",
    "tamilTagline": "உங்கள் பாதுகாப்பு. உங்கள் திறன். உங்கள் இறையாண்மை."
  },
  "colors": {
    "palette": {
      "deepPurple": { "hex": "#351080", "rgb": "rgb(53, 16, 128)", "role": "Brand anchor, deep headlines, sovereign foundation" },
      "royalViolet": { "hex": "#7027D9", "rgb": "rgb(112, 39, 217)", "role": "Primary action color, loading track, temple silhouette" },
      "brightMagenta": { "hex": "#E72DA7", "rgb": "rgb(231, 45, 167)", "role": "TN brand accent, flowing energy, career & innovation" },
      "lavender": { "hex": "#DDB7FF", "rgb": "rgb(221, 183, 255)", "role": "Sky background top, ambient mist, soft surfaces" },
      "palePink": { "hex": "#FCE8F7", "rgb": "rgb(252, 232, 247)", "role": "Sky background mid-tones, lotus blush" },
      "warmWhite": { "hex": "#FFFAFF", "rgb": "rgb(255, 250, 255)", "role": "Card canvas, pure highlights, pristine background" },
      "softGold": { "hex": "#FFD47A", "rgb": "rgb(255, 212, 122)", "role": "Rising sun, temple pinnacles, golden contour lines" }
    },
    "gradients": {
      "skyBackground": "linear-gradient(180deg, #E6D2F7 0%, #F4E8F8 30%, #FCEAF7 58%, #F7E0F5 78%, #EBD2F2 100%)",
      "loadingBar": "linear-gradient(90deg, #7027D9 0%, #C026D3 50%, #E72DA7 100%)",
      "brandText": "linear-gradient(135deg, #351080 0%, #7027D9 50%, #E72DA7 100%)",
      "landscapeWaves": "linear-gradient(135deg, #7027D9 0%, #8B2FC9 50%, #C026D3 100%)"
    }
  },
  "typography": {
    "fontFamilies": {
      "display": "'Outfit', system-ui, sans-serif",
      "body": "'Inter', system-ui, sans-serif",
      "tamil": "'Noto Sans Tamil', system-ui, sans-serif"
    },
    "scale": {
      "title": { "fontSize": "38px", "fontWeight": 800, "lineHeight": "44px" },
      "tagline": { "fontSize": "15px", "fontWeight": 500, "lineHeight": "22px", "letterSpacing": "0.01em" },
      "loading": { "fontSize": "12px", "fontWeight": 700, "letterSpacing": "0.35em" },
      "headline": { "fontSize": "24px", "fontWeight": 700, "lineHeight": "32px" },
      "body": { "fontSize": "15px", "fontWeight": 400, "lineHeight": "22px" }
    }
  },
  "radii": {
    "pill": "9999px",
    "card": "20px",
    "button": "14px"
  }
}
